import rclpy
from rclpy.node import Node
from sensor_msgs.msg import Image
from vision_msgs.msg import Detection2D, Detection2DArray, ObjectHypothesisWithPose
from cv_bridge import CvBridge
from ultralytics import YOLO
import cv2
import numpy as np

class YOLOv8Node(Node):
    def __init__(self):
        super().__init__('yolov8_node')

        # 订阅摄像头话题
        self.subscription = self.create_subscription(
            Image,
            '/ascamera/camera_publisher/rgb0/image',
            self.image_callback,
            10)

        # 发布检测结果（带标注的图像）
        self.image_pub = self.create_publisher(Image, '/yolov8/detections', 10)

        # 发布结构化检测数据（类别、位置、置信度）
        self.detection_pub = self.create_publisher(Detection2DArray, '/yolov8/detection_results', 10)

        self.bridge = CvBridge()
        self.model = YOLO('yolov8n.pt')  # 加载 YOLOv8 模型
        
        # 定义监控区域参数（需要根据实际相机参数调整）
        self.monitor_region = np.array([
            [320, 320],  # 左上
            [480, 320],  # 右上
            [560, 476],  # 右下
            [240, 476]   # 左下
        ], dtype=np.int32)
        
        self.get_logger().info("Obstacle Detector Initialized")

        # COCO 类别名称（80类）
        self.class_names = [
            'person', 'bicycle', 'car', 'motorcycle', 'airplane', 'bus', 'train',
            'truck', 'boat', 'traffic light', 'fire hydrant', 'stop sign',
            'parking meter', 'bench', 'bird', 'cat', 'dog', 'horse', 'sheep',
            'cow', 'elephant', 'bear', 'zebra', 'giraffe', 'backpack', 'umbrella',
            'handbag', 'tie', 'suitcase', 'frisbee', 'skis', 'snowboard',
            'sports ball', 'kite', 'baseball bat', 'baseball glove', 'skateboard',
            'surfboard', 'tennis racket', 'bottle', 'wine glass', 'cup', 'fork',
            'knife', 'spoon', 'bowl', 'banana', 'apple', 'sandwich', 'orange',
            'broccoli', 'carrot', 'hot dog', 'pizza', 'donut', 'cake', 'chair',
            'couch', 'potted plant', 'bed', 'dining table', 'toilet', 'tv',
            'laptop', 'mouse', 'remote', 'keyboard', 'cell phone', 'microwave',
            'oven', 'toaster', 'sink', 'refrigerator', 'book', 'clock', 'vase',
            'scissors', 'teddy bear', 'hair drier', 'toothbrush'
        ]

    def image_callback(self, msg):
        try:
            # 转换 ROS Image 为 OpenCV 格式
            cv_image = self.bridge.imgmsg_to_cv2(msg, 'bgr8')

            # 使用 YOLOv8 进行检测
            results = self.model(cv_image)
            annotated_frame = results[0].plot()  # 绘制检测框
            
            # 绘制监控区域
            cv2.polylines(annotated_frame, [self.monitor_region], 
                         isClosed=True, color=(0, 0, 255), thickness=2)
                     
                     
            # 发布带检测框的图像
            detection_msg = self.bridge.cv2_to_imgmsg(annotated_frame, 'bgr8')
            self.image_pub.publish(detection_msg)

            # 创建结构化检测结果消息
            detection_array = Detection2DArray()
            detection_array.header = msg.header

            for box in results[0].boxes:
                class_id = int(box.cls)
                confidence = float(box.conf)
                bbox = box.xywh[0].tolist()  # 格式：[x_center, y_center, width, height]

                # 构建 Detection2D 消息
                detection = Detection2D()
                detection.bbox.center.x = float(bbox[0])  # 中心点 x
                detection.bbox.center.y = float(bbox[1])  # 中心点 y
                detection.bbox.size_x = float(bbox[2])  # 宽度
                detection.bbox.size_y = float(bbox[3])  # 高度

                # 构建类别和置信度
                obj_pose = ObjectHypothesisWithPose()
                obj_pose.id = str(class_id)
                obj_pose.score = confidence
                detection.results.append(obj_pose)

                detection_array.detections.append(detection)

                # 在终端输出检测结果
                class_name = self.class_names[class_id]
                self.get_logger().info(
                    f"检测到物体: {class_name} | "
                    f"置信度: {confidence:.2f} | "
                    f"位置: ({bbox[0]:.1f}, {bbox[1]:.1f}) | "
                    f"尺寸: {bbox[2]:.1f}x{bbox[3]:.1f}"
                )

            # 发布结构化检测结果
            self.detection_pub.publish(detection_array)

        except Exception as e:
            self.get_logger().error(f"处理图像时出错: {str(e)}")

def main(args=None):
    rclpy.init(args=args)
    node = YOLOv8Node()
    rclpy.spin(node)
    node.destroy_node()
    rclpy.shutdown()

if __name__ == '__main__':
    main()


